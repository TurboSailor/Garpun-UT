#!/bin/sh
# Push helper: turns a raw payload into the notification the shell renders.
#
# lomiri-push-service hands us two paths: the payload it received and the file
# it expects the finished notification in. pulse-wdnotify already posts the
# final shape, so this is a straight copy — the helper exists because Postal
# refuses to deliver for an app that does not declare one.
#
# Anything other than valid JSON on stdout makes the service log
# "failed to parse HelperOutput", so keep this dumb and quiet.
set -eu

in_file="${1:-}"
out_file="${2:-}"

if [ -z "$in_file" ] || [ -z "$out_file" ]; then
    exit 1
fi

if [ ! -s "$in_file" ]; then
    # Nothing usable arrived; emit an empty envelope rather than invalid JSON.
    printf '{}' >"$out_file"
    exit 0
fi

cat "$in_file" >"$out_file"
